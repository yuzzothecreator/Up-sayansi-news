# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Set to "true" when Postgres is not running (local UI preview with mock data).
# Set to "false" after configuring DATABASE_URL and running db:push / db:seed.
USE_MOCK_DATA=true

# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543, ?pgbouncer=true) — app runtime
# DIRECT_URL   = Direct connection (port 5432) — Prisma migrate / db push
#
# Example (replace [ref], [password], [region]):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres"
#
# Local Postgres fallback:
DATABASE_URL=postgresql://postgres:password@localhost:5432/pulse?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/pulse?schema=public

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-long-change-me
BETTER_AUTH_URL=http://localhost:3000

# ─── OAuth providers (optional) ───────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Supabase (storage) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Pulse <hello@yourdomain.com>

# ─── Rate limiting / caching (optional, production) ───────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ─── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_ADS=false
