# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Set to "true" when the database is not configured (local UI preview with mock data).
# Set to "false" after configuring DATABASE_URL and running db:push / db:seed.
USE_MOCK_DATA=true

# ─── Database (TiDB Cloud) ────────────────────────────────────────────────────
# 1. Create a free cluster at https://tidbcloud.com/
# 2. Open your cluster → Connect → copy user, host, password
# 3. CA cert is at certs/isrgrootx1.pem (use an absolute path in sslcert)
# 4. Create app DB: CREATE DATABASE IF NOT EXISTS upsayansi;
#
# DATABASE_URL="mysql://<user>:<password>@<host>:4000/upsayansi?sslaccept=strict&sslcert=<abs-path-to-certs/isrgrootx1.pem>"
#
DATABASE_URL="mysql://username:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/upsayansi?sslaccept=strict&sslcert=./certs/isrgrootx1.pem"

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-long-change-me
BETTER_AUTH_URL=http://localhost:3000

# ─── OAuth providers (optional) ───────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Supabase (storage only) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=UpSayansi News <hello@yourdomain.com>

# ─── Rate limiting / caching (optional, production) ───────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ─── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_ADS=false
